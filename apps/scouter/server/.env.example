# apps/scouter/server/.env にコピーして使う(gitignore 済み)
PORT=8787
# 設定すると /transcribe /analyze に Bearer 認証を要求(LAN 開発では空で可。Workers では必須)
SHARED_SECRET=

# ---- STT(文字起こし)----
# STT_PROVIDER: auto | whisper | openai | gemini | mock   (auto = キーがある方を使う。無ければ mock)
#   whisper = PC 上の whisper-server(無料・無制限・オフライン)。npm run whisper:setup → npm run start で自動起動
#   gemini の無料枠は 1 日 20 リクエストしかないので、このアプリには実質使えない(課金するか whisper を使う)
STT_PROVIDER=auto
WHISPER_URL=http://127.0.0.1:8178/v1
WHISPER_MODEL=server/models/ggml-large-v3-turbo.bin
# 用語集(誤認識しやすい固有名詞・専門用語を「、」区切りで。whisper の初期プロンプトになる)
WHISPER_PROMPT=網羅性、スカウター、Even G2、Claude
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OpenAI 互換エンドポイントに差し替え可(例: ローカル whisper.cpp server → http://127.0.0.1:8080/v1、キー不要)
OPENAI_STT_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.6-flash
STT_LANGUAGE=ja

# ---- LLM(状態解析)----
# LLM_PROVIDER: auto | claude-code | anthropic | openai | gemini | mock | jev | jev+<上のどれか>
#   auto = Claude Code(`claude`)がログイン済みならサブスク枠の claude-code、無ければキーのある API、無ければ mock
#   jev            = Jev(TypeSafe AI の判定専用モデル)だけ。喜怒哀楽・顔・mood・スコアを 100〜500ms で判定、文章欄は空
#   jev+claude-code = Jev の判定 + LLM の文章(助言・要約・memory)を並列に取って合成(本命の構成)
#   起動中の切り替えは POST /analyze?provider=<name>(/health の llmOptions に一覧)。並べて比較は `npm run compare`
LLM_PROVIDER=auto
# claude-code(Node 専用): モデルは sonnet | opus | haiku 等の alias か完全な ID。リアルタイム用途なので sonnet/low が既定
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_EFFORT=low
CLAUDE_BIN=claude
# セッション継続(--resume で新しい発話だけ送る。1=on / 0=off)。上限に達すると memory + 直近 PROMPT_TURNS 発話で巻き直す
CLAUDE_CODE_SESSION=1
SESSION_MAX_CALLS=40
SESSION_MAX_MINUTES=30
PROMPT_TURNS=10
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high  (リアルタイム用途なので low 推奨)
ANTHROPIC_EFFORT=low
OPENAI_LLM_MODEL=gpt-4o-mini
GEMINI_LLM_MODEL=gemini-3.6-flash

# ---- Jev(TypeSafe AI)----
# キーは https://typesafe.ai の waitlist(半日程度・5 ドル分クレジット付き)か、Vercel AI Gateway 等の互換エンドポイントで取得。
# 入力 100 万トークン 0.042 ドル・出力無料。LLM_PROVIDER=jev / jev+… と STT_GATE=jev で使う
TYPESAFE_API_KEY=
# 互換エンドポイントに差し替える時だけ(省略時は https://api.typesafe.ai)
TYPESAFE_BASE_URL=
JEV_MODEL=jev-latest
# Jev に渡す直近発話数(state が大きいと精度が落ちる公式注記あり)
JEV_TURNS=6
# 文字起こしのゲート: off(従来: 正規表現の幻聴リストのみ) | jev(加えて Noul で「実発話か」を判定し、閾値未満を捨てる)
STT_GATE=off
JEV_GATE_THRESHOLD=0.5
